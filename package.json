{
  "name": "@ktav-lang/polydoc",
  "version": "0.1.0",
  "description": "Assemble multi-language documents from per-section source units that carry every configured language, with drift protection, journalled crash recovery for output writes, and structural translation-parity checks.",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/build-docs.mjs --check"
  },
  "files": [
    "src",
    "README.md",
    "README.ru.md",
    "README.zh.md",
    "CHANGELOG.md",
    "CHANGELOG.ru.md",
    "CHANGELOG.zh.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "keywords": [
    "documentation",
    "documentation-generator",
    "markdown",
    "i18n",
    "l10n",
    "localization",
    "translation",
    "ktav"
  ],
  "author": "Marat K <phpcraftdream@gmail.com>",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/ktav-lang/polydoc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ktav-lang/polydoc.git"
  },
  "bugs": {
    "url": "https://github.com/ktav-lang/polydoc/issues"
  }
}
